# Copy to .env; URL-encode only the password component of ANALYTICS_DB.
ANALYTICS_DB=mysql://pixelflow_analytics:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:3306/pixelflow_analytics
JAVA_BASE_URL=http://127.0.0.1:8080
PIXELFLOW_ANALYTICS_EXPORT_TOKEN=CHANGE_ME_SHARED_EXPORT_TOKEN
PIXELFLOW_INTELLIGENCE_TOKEN=CHANGE_ME_SEPARATE_MAINTENANCE_TOKEN
PIXELFLOW_MAINTENANCE_URL=http://127.0.0.1:8001
# Server-only; an empty key uses the explicitly labelled rules preview.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
