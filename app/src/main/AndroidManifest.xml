<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.PixelFlow.app"
    tools:ignore="ExtraText">

    <!-- 基础网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 音频相关权限 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 前台服务权限（Android 9+ 必须） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        android:foregroundServiceType="mediaPlayback" />

    <!-- 音频焦点权限 -->
    <uses-permission android:name="android.permission.AUDIOFOCUS" />

    <!-- 存储权限（如果音频文件在本地） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 清除attributionTag警告 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 如果需要拍照功能 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/app"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- 拍摄新作品：临时照片通过 FileProvider 授权给相机应用 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.PixelFlow.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ================== SplashActivity（启动页） ================== -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PixelFlow.Splash"
            android:screenOrientation="portrait">
            <!-- 设置为启动Activity -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ================== MainActivity（主界面） ================== -->
        <activity android:name=".AccountActivity" android:exported="false" android:theme="@style/Theme.PixelFlow.Profile" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".EditProfileActivity" android:exported="false" android:theme="@style/Theme.PixelFlow.Profile" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".InterestProfileActivity" android:exported="false" android:theme="@style/Theme.PixelFlow.Profile" />
        <activity android:name=".HistoryProfileActivity" android:exported="false" android:theme="@style/Theme.PixelFlow.Profile" />
        <activity android:name=".PreferencesActivity" android:exported="false" android:theme="@style/Theme.PixelFlow.Profile" />
        <activity android:name=".ConnectionsActivity" android:exported="false" android:theme="@style/Theme.PixelFlow.Profile" />
        <activity android:name=".UserProfileActivity" android:exported="false" android:theme="@style/Theme.PixelFlow.Profile" />
        <activity android:name=".MyWorksActivity" android:exported="false" android:theme="@style/Theme.PixelFlow.Profile" />
        <activity android:name=".FavoritesActivity" android:exported="false" android:theme="@style/Theme.PixelFlow.Profile" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.PixelFlow.Profile"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <!-- 注意：这里移除了 MAIN 和 LAUNCHER 的 intent-filter -->
        </activity>

        <!-- ================== 详情页Activity ================== -->
        <activity
            android:name=".DetailPage.WorkDetailActivity"
            android:theme="@style/Theme.Detail"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- ================== 话题页Activity ================== -->
        <activity
            android:name=".Hashtag.HashtagActivity"
            android:exported="false"
            android:theme="@style/Theme.Detail"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- ================== 创建作品Activity ================== -->
        <activity
            android:name=".CreateWorkActivity"
            android:exported="false"
            android:theme="@style/Theme.Detail"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

    </application>
</manifest>
