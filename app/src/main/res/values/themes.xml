<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 主应用主题 - PixelFlow 商用设计系统（与 profile_* 令牌同源） -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 品牌色 -->
        <item name="colorPrimary">@color/profile_accent</item>
        <item name="colorPrimaryVariant">@color/brand_violet_deep</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- 次要色：与主色同族，保持克制 -->
        <item name="colorSecondary">@color/brand_violet_light</item>
        <item name="colorSecondaryVariant">@color/brand_violet</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- 纸面与文字 -->
        <item name="android:colorBackground">@color/profile_bg</item>
        <item name="colorSurface">@color/profile_surface</item>
        <item name="colorOnBackground">@color/profile_ink</item>
        <item name="colorOnSurface">@color/profile_ink</item>
        <item name="colorError">@color/profile_error</item>

        <!-- 状态栏 / 导航栏：浅色纸面 + 深色图标 -->
        <item name="android:statusBarColor">@color/profile_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/profile_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/profile_bg</item>

        <!-- 交互反馈：低强度靛紫波纹，避免默认灰色太生硬 -->
        <item name="colorControlHighlight">@color/accent_ripple</item>
        <item name="rippleColor">@color/accent_ripple</item>

        <!-- 统一组件圆角家族 -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeRounded.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeRounded.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeRounded.Large</item>

        <!-- Material Components 配置 -->
        <item name="materialButtonStyle">@style/Widget.PixelFlow.Button</item>
        <item name="textAppearanceButton">@style/TextAppearance.MaterialComponents.Button</item>
    </style>

    <!-- 圆角家族 -->
    <style name="ShapeRounded.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_control</item>
    </style>
    <style name="ShapeRounded.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>
    <style name="ShapeRounded.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- 全局主按钮：52dp 高、全圆角端 -->
    <style name="Widget.PixelFlow.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- 详情页专用主题 -->
    <style name="Theme.Detail" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 状态栏 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- 导航栏 -->
        <item name="android:navigationBarColor">@color/white</item>

        <!-- 窗口 -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowTranslucentStatus">true</item>

        <!-- 确保 MaterialButton 能正常工作 -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
    </style>

    <!-- 夜间模式主题（如果需要） -->
    <style name="AppTheme.Night" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 夜间模式配置 -->
    </style>

    <!-- Splash主题 -->
    <style name="Theme.PixelFlow.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 全屏显示 -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>

        <!-- 关键：背景颜色与布局背景一致 -->
        <item name="android:windowBackground">@color/white</item>

        <!-- 状态栏和导航栏透明 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- 关键：让内容延伸到状态栏下面 -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- 关键：确保绘制在系统栏下面 -->
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>

        <!-- 禁用默认进入/退出动画 -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>