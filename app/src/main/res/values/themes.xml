<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 主应用主题 - 使用 Material Components -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 基础颜色 -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- 次要颜色 -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- 状态栏 -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Material Components 配置 -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="textAppearanceButton">@style/TextAppearance.MaterialComponents.Button</item>
    </style>

    <!-- 详情页专用主题 -->
    <style name="Theme.Detail" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 状态栏 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- 导航栏 -->
        <item name="android:navigationBarColor">@color/white</item>

        <!-- 窗口 -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowTranslucentStatus">true</item>

        <!-- 确保 MaterialButton 能正常工作 -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
    </style>

    <!-- 夜间模式主题（如果需要） -->
    <style name="AppTheme.Night" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 夜间模式配置 -->
    </style>

    <!-- Splash主题 -->
    <style name="Theme.PixelFlow.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 全屏显示 -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>

        <!-- 关键：背景颜色与布局背景一致 -->
        <item name="android:windowBackground">@color/white</item>

        <!-- 状态栏和导航栏透明 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- 关键：让内容延伸到状态栏下面 -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- 关键：确保绘制在系统栏下面 -->
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>

        <!-- 禁用默认进入/退出动画 -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>