<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 详情页透明主题 -->
    <style name="Theme.Detail.Transparent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AiAssistDialog" parent="android:Theme.Material.Light.Dialog">
        <!-- 圆角背景由内容视图自绘，窗口背景必须透明，否则四角会露出矩形底 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowNoTitle">true</item>
        <!-- 软键盘弹出时不重排窗口，避免弹窗整体上下跳动 -->
        <item name="android:windowSoftInputMode">stateHidden|adjustNothing</item>
    </style>

    <style name="ThemeOverlay.PixelFlow.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/profile_accent</item>
        <item name="colorSecondary">@color/profile_accent</item>
        <item name="colorSurface">@color/profile_surface</item>
        <item name="colorOnSurface">@color/profile_ink</item>
        <item name="android:textColorPrimary">@color/profile_ink</item>
        <item name="android:textColorSecondary">@color/profile_muted</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PixelFlow.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/PixelFlow.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/PixelFlow.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/PixelFlow.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/PixelFlow.Dialog.Button.Secondary</item>
    </style>

    <style name="ThemeOverlay.PixelFlow.Dialog.Destructive">
        <item name="buttonBarPositiveButtonStyle">@style/PixelFlow.Dialog.Button.Destructive</item>
    </style>

    <style name="ShapeAppearance.PixelFlow.Dialog" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="PixelFlow.Dialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/profile_ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PixelFlow.Dialog.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/profile_muted</item>
    </style>

    <style name="PixelFlow.Dialog.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/profile_accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="PixelFlow.Dialog.Button.Secondary">
        <item name="android:textColor">@color/profile_muted</item>
    </style>
    <style name="PixelFlow.Dialog.Button.Destructive">
        <item name="android:textColor">@color/profile_error</item>
    </style>

    <style name="FullScreenDialogAnimation">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>