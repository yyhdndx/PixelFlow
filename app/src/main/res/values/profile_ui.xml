<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="profile_bg">#F7F7FC</color>
    <color name="profile_surface">#FFFFFF</color>
    <color name="profile_ink">#242337</color>
    <color name="profile_muted">#747387</color>
    <color name="profile_accent">#6155CE</color>
    <color name="profile_soft">#EFEDFF</color>
    <color name="profile_border">#E7E6F0</color>
    <color name="profile_error">#B3261E</color>
    <style name="Theme.PixelFlow.ProfileBase" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/profile_accent</item>
        <item name="colorPrimaryVariant">@color/profile_accent</item>
        <item name="colorSecondary">@color/profile_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/profile_bg</item>
        <item name="android:statusBarColor">@color/profile_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/profile_surface</item>
        <item name="android:fontFamily">sans</item>
        <item name="colorError">@color/profile_error</item>
    </style>
    <style name="Theme.PixelFlow.Profile" parent="Theme.PixelFlow.ProfileBase"/>
    <style name="ProfileTitle">
        <item name="android:textColor">@color/profile_ink</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ProfileBody">
        <item name="android:textColor">@color/profile_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="ProfileButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/profile_accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="ProfileInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@color/profile_surface</item>
    </style>
