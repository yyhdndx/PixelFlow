<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/profile_bg">

    <!-- 顶部栏：返回 + 居中标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/account_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/profile_back"
            android:padding="10dp"
            app:tint="@color/profile_ink"
            android:contentDescription="@string/profile_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/profile_account"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/profile_ink" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- 品牌区：logo + 大标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_account_logo"
                    android:padding="16dp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/profile_accent"
                    android:contentDescription="PixelFlow" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PIXELFLOW"
                        android:textSize="12sp"
                        android:letterSpacing="0.22"
                        android:textStyle="bold"
                        android:textColor="@color/profile_accent" />

                    <TextView
                        android:id="@+id/account_heading"
                        style="@style/ProfileTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="24sp"
                        android:text="@string/account_title" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/account_description"
                style="@style/ProfileBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:text="@string/account_subtitle" />

            <!-- 表单卡片 -->
            <LinearLayout
                android:id="@+id/account_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_form_card"
                android:padding="20dp"
                android:layout_marginTop="20dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/account_username_layout"
                    style="@style/ProfileInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/account_username"
                    app:startIconDrawable="@drawable/ic_person_outline"
                    app:counterEnabled="true"
                    app:counterMaxLength="32">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/account_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:inputType="text"
                        android:saveEnabled="false"
                        android:textColor="@color/profile_ink"
                        android:textSize="16sp"
                        android:maxLength="32"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/account_password_layout"
                    style="@style/ProfileInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/account_password"
                    app:startIconDrawable="@drawable/ic_lock_outline"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/account_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:inputType="textPassword"
                        android:saveEnabled="false"
                        android:textColor="@color/profile_ink"
                        android:textSize="16sp"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/account_nickname_layout"
                    style="@style/ProfileInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/profile_nickname"
                    app:startIconDrawable="@drawable/ic_edit_note"
                    app:counterEnabled="true"
                    app:counterMaxLength="40">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/account_nickname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:inputType="textCapSentences"
                        android:saveEnabled="false"
                        android:textColor="@color/profile_ink"
                        android:textSize="16sp"
                        android:maxLength="40"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/account_submit"
                    style="@style/ProfileButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cornerRadius="22dp"
                    android:text="@string/account_login" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/account_toggle"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/account_switch_register"
                    android:textColor="@color/profile_accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 已登录态 -->
            <LinearLayout
                android:id="@+id/account_session"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_form_card"
                android:padding="20dp"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/account_return"
                    style="@style/ProfileButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cornerRadius="22dp"
                    android:text="@string/account_return" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/account_logout"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/account_logout"
                    android:textColor="@color/profile_error"
                    android:textSize="14sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/account_loading"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/profile_accent"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/account_status"
                style="@style/ProfileBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_soft"
                android:padding="12dp"
                android:gravity="center"
                android:textColor="@color/profile_accent"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <TextView
                style="@style/ProfileBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/account_memory_hint"
                android:textSize="12sp"
                android:gravity="center" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
