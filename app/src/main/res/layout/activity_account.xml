<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/profile_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
        <ImageButton android:id="@+id/account_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/profile_back" android:contentDescription="@string/profile_back"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_account" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/profile_ink"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="16dp" android:paddingBottom="32dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PIXELFLOW" android:textSize="12sp" android:letterSpacing="0.2" android:textStyle="bold" android:textColor="@color/profile_accent" android:layout_marginBottom="20dp"/>
            <TextView android:id="@+id/account_heading" style="@style/ProfileTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_title"/>
            <TextView android:id="@+id/account_description" style="@style/ProfileBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/account_subtitle"/>
            <LinearLayout android:id="@+id/account_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/account_username_layout" style="@style/ProfileInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="@string/account_username" app:counterEnabled="true" app:counterMaxLength="32">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/account_username" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="text" android:saveEnabled="false" android:textColor="@color/profile_ink" android:textSize="16sp" android:maxLength="32" android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/account_password_layout" style="@style/ProfileInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="@string/account_password" app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/account_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:saveEnabled="false" android:textColor="@color/profile_ink" android:textSize="16sp" android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/account_nickname_layout" style="@style/ProfileInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="@string/profile_nickname" app:counterEnabled="true" app:counterMaxLength="40">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/account_nickname" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textCapSentences" android:saveEnabled="false" android:textColor="@color/profile_ink" android:textSize="16sp" android:maxLength="40" android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/account_submit" style="@style/ProfileButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/account_login"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/account_toggle" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_switch_register"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/account_session" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="28dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/account_return" style="@style/ProfileButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_return"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/account_logout" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_logout" android:textColor="@color/profile_error" android:layout_marginTop="12dp"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/account_loading" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:layout_marginTop="20dp" android:visibility="gone"/>
            <TextView android:id="@+id/account_status" style="@style/ProfileBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
            <TextView style="@style/ProfileBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/account_memory_hint" android:textSize="12sp" android:gravity="center"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
