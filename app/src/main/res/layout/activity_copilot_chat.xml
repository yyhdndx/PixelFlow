<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_bg"
    android:orientation="vertical">

    <!-- 顶部：返回历史 + 当前上下文 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/profile_surface"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/chat_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/copilot_back_to_history"
            android:padding="10dp"
            android:src="@drawable/profile_back" />

        <TextView
            android:id="@+id/chat_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/profile_ink"
            android:textSize="15sp"
            android:textStyle="bold" />


    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
        android:id="@+id/chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">


        <LinearLayout
            android:id="@+id/chat_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </ScrollView>        <!-- 悬浮跳转：上一条 / 下一条 / 回到底部（仅图标） -->
        <LinearLayout
            android:id="@+id/chat_jump_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/chat_jump_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_jump_circle"
                android:contentDescription="@string/copilot_jump_prev"
                android:elevation="3dp"
                android:padding="9dp"
                android:src="@drawable/ic_jump_prev" />

            <ImageButton
                android:id="@+id/chat_jump_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_jump_circle"
                android:contentDescription="@string/copilot_jump_next"
                android:elevation="3dp"
                android:padding="9dp"
                android:src="@drawable/ic_jump_next" />

            <ImageButton
                android:id="@+id/chat_jump_bottom"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_jump_circle"
                android:contentDescription="@string/copilot_jump_bottom"
                android:elevation="3dp"
                android:padding="9dp"
                android:src="@drawable/ic_jump_bottom" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/chat_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        android:textColor="@color/profile_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/profile_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/chat_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="@string/copilot_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxLength="500"
            android:maxLines="3"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/profile_ink"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_send"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="64dp"
            android:text="@string/copilot_send"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:backgroundTint="@color/profile_accent"
            app:cornerRadius="20dp" />
    </LinearLayout>
</LinearLayout>
