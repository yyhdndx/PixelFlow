<?xml version="1.0" encoding="utf-8"?>
<!-- AI 综合回答卡片：作为搜索瀑布流的全宽头部项，随作品一起滚动 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_form_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 头部：标题 + 停止 + 收起 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/search_ai_title"
            android:textColor="@color/profile_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ai_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/ai_stop"
            android:textColor="@color/profile_accent"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/ai_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_ai_close"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            app:tint="@color/profile_muted" />
    </LinearLayout>

    <!-- 生成中 -->
    <LinearLayout
        android:id="@+id/ai_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="@color/profile_accent" />

        <TextView
            android:id="@+id/ai_loading_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/ai_preparing"
            android:textColor="@color/profile_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 降级提示 -->
    <TextView
        android:id="@+id/ai_degraded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/search_ai_degraded"
        android:textColor="@color/profile_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 回答正文 + 来源（随列表滚动，不内嵌滚动） -->
    <LinearLayout
        android:id="@+id/ai_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/ai_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.35"
            android:textColor="@color/profile_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ai_sources_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/search_ai_sources"
            android:textColor="@color/profile_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ai_sources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
