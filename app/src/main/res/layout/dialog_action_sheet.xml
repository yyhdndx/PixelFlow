<?xml version="1.0" encoding="utf-8"?>
<!-- PixelFlow 底部动作面板：抓手 + 标题 + 副标题 + 选项列表 + 取消 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingBottom="8dp">

    <!-- 抓手 -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_grabber" />

    <!-- 标题 -->
    <TextView
        android:id="@+id/sheet_title"
        style="@style/TextTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center" />

    <!-- 副标题 -->
    <TextView
        android:id="@+id/sheet_subtitle"
        style="@style/TextCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- 选项容器（代码动态填充） -->
    <LinearLayout
        android:id="@+id/sheet_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/profile_border" />

    <!-- 取消 -->
    <TextView
        android:id="@+id/sheet_cancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="@string/profile_cancel"
        android:textColor="@color/profile_accent"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/profile_cancel" />

</LinearLayout>
