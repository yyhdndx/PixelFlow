<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/profile_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
        <ImageButton android:id="@+id/editor_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/profile_back" android:contentDescription="@string/profile_back"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_editor_title" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/profile_ink"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="16dp" android:paddingBottom="32dp">
            <TextView style="@style/ProfileTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_editor_desc" android:textSize="23sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp" android:padding="20dp" android:background="@drawable/profile_card">
                <ImageView android:id="@+id/editor_avatar" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/profile_avatar" android:contentDescription="@string/profile_avatar"/>
                <TextView style="@style/ProfileBody" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:text="@string/profile_avatar_readonly"/>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/edit_nickname_layout" style="@style/ProfileInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="@string/profile_nickname" app:counterEnabled="true" app:counterMaxLength="40">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_nickname" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textCapSentences" android:saveEnabled="false" android:textColor="@color/profile_ink" android:textSize="16sp" android:maxLength="40" android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/edit_bio_layout" style="@style/ProfileInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="@string/profile_bio" app:counterEnabled="true" app:counterMaxLength="60">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_bio" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textMultiLine|textCapSentences" android:saveEnabled="false" android:textColor="@color/profile_ink" android:textSize="16sp" android:maxLength="60" android:minLines="4" android:gravity="top"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView style="@style/ProfileBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_editor_hint" android:textSize="12sp" android:layout_marginTop="8dp"/>
            <ProgressBar android:id="@+id/editor_loading" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:layout_marginTop="20dp" android:visibility="gone"/>
            <TextView android:id="@+id/editor_status" style="@style/ProfileBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/editor_retry" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_retry" android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/editor_save" style="@style/ProfileButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_save" android:enabled="false" android:layout_marginTop="24dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
