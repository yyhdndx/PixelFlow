<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/profile_bg">

    <!-- 上层Tab导航 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/profile_surface"
        app:tabTextAppearance="@style/HomeTabLabel"
        app:tabTextColor="@color/profile_muted"
        app:tabSelectedTextColor="@color/profile_accent"
        app:tabIndicatorColor="@color/profile_accent"
        app:tabIndicatorHeight="2dp"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed" />

    <!-- 推荐策略横幅 -->
    <TextView
        android:id="@+id/rec_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EFEDFF"
        android:padding="10dp"
        android:textSize="13sp"
        android:textColor="#6155CE"
        android:gravity="center"
        android:visibility="gone" />

    <!-- 下拉刷新容器 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 瀑布流RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="0dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 空状态页面 -->
    <LinearLayout
        android:id="@+id/empty_state_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_empty_state"
            android:contentDescription="@string/emptyContent" />

        <TextView
            android:id="@+id/feed_state_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/home_empty_title"
            android:textColor="@color/profile_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/feed_state_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_empty_community"
            android:gravity="center"
            android:accessibilityLiveRegion="polite"
            android:textSize="14sp"
            android:textColor="@color/profile_muted" />

        <Button
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reloading"
            android:backgroundTint="@color/profile_accent"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/feed_page_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/feed_page_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/profile_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/feed_page_retry"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/home_retry"
            android:visibility="gone"
            android:textColor="@color/profile_accent" />
    </LinearLayout>

</LinearLayout>
