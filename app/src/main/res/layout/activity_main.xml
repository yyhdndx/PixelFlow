<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_100">

    <!-- Fragment容器 -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation" />

    <!-- 底部导航栏 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@android:color/white"
        app:menu="@menu/bottom_nav_menu"
        app:elevation="0dp"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="20dp"
        app:itemTextAppearanceActive="@style/HomeNavigationLabel"
        app:itemTextAppearanceInactive="@style/HomeNavigationLabel"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color" />

    <!-- 相机按钮：填满导航内容区高度，与导航项垂直居中对齐 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/bottom_navigation"
        android:layout_centerHorizontal="true"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="@string/home_create"
        app:fabCustomSize="56dp"
        app:maxImageSize="24dp"
        app:useCompatPadding="false"
        app:backgroundTint="@color/profile_accent"
        app:tint="@android:color/white"
        app:elevation="0dp"
        app:rippleColor="@color/profile_soft" />

</RelativeLayout>
