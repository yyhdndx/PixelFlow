<?xml version="1.0" encoding="utf-8"?>
<!-- 次按钮：纸白底 + 细边框；禁用时底色与文字一起弱化 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/profile_surface" />
            <stroke android:width="1dp" android:color="@color/profile_border" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F4F3FA" />
            <stroke android:width="1dp" android:color="#EFEEF7" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
</selector>