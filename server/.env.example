# Copy to .env; replace CHANGE_ME values and import into the process before starting.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/pixelflow_app?connectionTimeZone=UTC&tinyInt1isBit=true&allowPublicKeyRetrieval=true&sslMode=DISABLED
DB_USER=pixelflow_app
DB_PASSWORD=CHANGE_ME_LOCAL_JAVA_DATABASE_PASSWORD
PIXELFLOW_JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET
PIXELFLOW_ANALYTICS_EXPORT_TOKEN=CHANGE_ME_SHARED_EXPORT_TOKEN
PIXELFLOW_INTELLIGENCE_BASE_URL=http://127.0.0.1:8001
PIXELFLOW_SEED=false
PIXELFLOW_PUBLIC_BASE_URL=http://127.0.0.1:8080
PIXELFLOW_ADMIN_PASSWORD=
