# Copy to .env; replace CHANGE_ME values and import into the process before starting.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/pixelflow_app?connectionTimeZone=UTC&tinyInt1isBit=true&allowPublicKeyRetrieval=true&sslMode=DISABLED
DB_USER=pixelflow_app
DB_PASSWORD=CHANGE_ME_LOCAL_JAVA_DATABASE_PASSWORD
PIXELFLOW_JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET
PIXELFLOW_ANALYTICS_EXPORT_TOKEN=CHANGE_ME_SHARED_EXPORT_TOKEN
PIXELFLOW_INTELLIGENCE_BASE_URL=http://127.0.0.1:8001
PIXELFLOW_SEED=false
PIXELFLOW_PUBLIC_BASE_URL=http://127.0.0.1:8080
PIXELFLOW_ADMIN_PASSWORD=
PIXELFLOW_RATE_LIMIT_ENABLED=false
PIXELFLOW_RATE_LIMIT_NAMESPACE=pixelflow:local
PIXELFLOW_RATE_LIMIT_TRUSTED_PROXIES=
PIXELFLOW_RATE_LIMIT_LOGIN_IP_LIMIT=100
PIXELFLOW_RATE_LIMIT_LOGIN_IP_WINDOW=60s
PIXELFLOW_RATE_LIMIT_LOGIN_ACCOUNT_LIMIT=10
PIXELFLOW_RATE_LIMIT_LOGIN_ACCOUNT_WINDOW=60s
PIXELFLOW_RATE_LIMIT_REGISTER_IP_LIMIT=10
PIXELFLOW_RATE_LIMIT_REGISTER_IP_WINDOW=600s
PIXELFLOW_RATE_LIMIT_UPLOAD_USER_LIMIT=30
PIXELFLOW_RATE_LIMIT_UPLOAD_USER_WINDOW=60s
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=300ms
REDIS_COMMAND_TIMEOUT=300ms
